# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careflow

# Server Configuration
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Email Configuration (Resend or any SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM=CareFlow <bookings@yourdomain.com>

# AI Integration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Google Calendar OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary
